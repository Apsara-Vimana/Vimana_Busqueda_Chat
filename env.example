# ─────────────────────────────────────────────────────────────
# Apsara Vimana — variables de entorno (ejemplo)
# Archivo: env.example  (sin punto delante)
# Valores REALES solo en Render → Environment
# NUNCA subas claves reales a GitHub
# ─────────────────────────────────────────────────────────────

PORT=3000

# Neon (cada chat A/B/C tiene la suya)
DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require

# Identidad de ESTE servicio: A | B | C
# A https://vimana-chat.onrender.com
# B https://apsara-vimana-chat-b-aibp.onrender.com
# C https://apsara-vimana-c.onrender.com
INSTANCE_POOL=A

# SearXNG (hoy el único activo)
SEARXNG_URL=https://apsara-searxng.onrender.com
# Cuando existan:
# SEARXNG_URL=https://apsara2-searxng.onrender.com
# SEARXNG_URL=https://apsara3-searxng.onrender.com
# Opcional por pool:
# SEARXNG_URL_A=https://apsara-searxng.onrender.com
# SEARXNG_URL_B=https://apsara2-searxng.onrender.com
# SEARXNG_URL_C=https://apsara3-searxng.onrender.com

# Claves de acceso (vacío = abierto)
ACCESS_CODES=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
SITE_URL=https://vimana-chat.onrender.com
SITE_NAME=Apsara Vimana

# Jamendo
JAMENDO_CLIENT_ID=
