# Neon Postgres (Render → Environment)
DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require

# Tu SearXNG en Render (segundo servicio)
SEARXNG_URL=https://apsara-searxng.onrender.com

# Hugging Face Inference API (opcional — embeddings gte-small)
# Solo en Render Environment; NUNCA subas el token real a GitHub
HUGGINGFACE_TOKEN=

PORT=3000

# OpenRouter (NVIDIA Nemotron 3 Ultra gratis)
# Solo en Render Environment — NUNCA subas la clave real a GitHub
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
SITE_URL=https://vimana-chat.onrender.com
SITE_NAME=Apsara Vimana
