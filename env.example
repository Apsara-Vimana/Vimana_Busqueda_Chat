# ─────────────────────────────────────────────────────────────
# Apsara Vimana — ejemplo de variables (env.example)
# Valores REALES solo en Render → Environment
# NUNCA subas claves reales ni tokens a GitHub
# ─────────────────────────────────────────────────────────────

PORT=3000

# Neon (cada chat A / B / C tiene la suya)
DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require

# Identidad de ESTE servicio: A | B | C
INSTANCE_POOL=A

# Metabuscador de ESTE servicio
SEARXNG_URL=https://apsara-searxng.onrender.com

# ── Llaves de acceso (solo Render) ──
# Administrador (válida en A, B y C; sin límite de sesiones)
ADMIN_KEY=

# 20 llaves de invitados de ESTE servidor (coma, sin espacios)
# Solo las que empiezan por la letra de este pool (A… / B… / C…)
USER_KEYS=

# Máximo 2 sesiones simultáneas por llave de invitado (sin límite por IP)

# ── IA (solo Render; no documentar proveedor ni modelo en el repo) ──
OPENROUTER_API_KEY=

# Sitio (público, sin secretos)
SITE_URL=https://vimana-chat.onrender.com
SITE_NAME=Apsara Vimana

# Música (client id público de app; no es la lista de llaves de chat)
JAMENDO_CLIENT_ID=
