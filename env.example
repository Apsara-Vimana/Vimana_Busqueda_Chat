# ─────────────────────────────────────────────────────────────
# Apsara Vimana — variables de entorno (ejemplo)
# Archivo: env.example  (sin punto delante)
# Copia los valores REALES solo en Render → Environment
# NUNCA subas claves reales a GitHub
# ─────────────────────────────────────────────────────────────

# Puerto (Render lo define; local por defecto 3000)
PORT=3000

# ── Neon Postgres (cada chat A/B/C tiene su propia DATABASE_URL) ──
DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require

# ── Identidad de ESTE servicio en Render: A | B | C ──
# Chat A: https://vimana-chat.onrender.com
# Chat B: https://apsara-vimana-chat-b-aibp.onrender.com
# Chat C: https://apsara-vimana-c.onrender.com
INSTANCE_POOL=A

# ── SearXNG (metabuscador) ──
# Hoy (activo cuando hay cuota):
SEARXNG_URL=https://apsara-searxng.onrender.com
# Cuando existan las instancias 2 y 3:
# SEARXNG_URL=https://apsara2-searxng.onrender.com   # chat B
# SEARXNG_URL=https://apsara3-searxng.onrender.com   # chat C
#
# Opcional — override por pool (si un solo front enruta por clave):
# SEARXNG_URL_A=https://apsara-searxng.onrender.com
# SEARXNG_URL_B=https://apsara2-searxng.onrender.com
# SEARXNG_URL_C=https://apsara3-searxng.onrender.com

# ── Claves de acceso al chat (opcional) ──
# Vacío = abierto. Lista separada por comas.
# Prefijo B… → pool B | Prefijo C… → pool C | resto → A/default
# ACCESS_CODES=A7K2M,B9P4X,C3L8Q
ACCESS_CODES=

# ── OpenRouter (NVIDIA Nemotron 3 Ultra gratis) ──
# Solo en Render Environment — no subir la clave real
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
SITE_URL=https://vimana-chat.onrender.com
SITE_NAME=Apsara Vimana

# ── Jamendo API (música instrumental Creative Commons) ──
# Portal: https://devportal.jamendo.com/ → Application → client_id
JAMENDO_CLIENT_ID=

# ── Referencia rápida de URLs ──
# SearXNG 1: https://apsara-searxng.onrender.com
# SearXNG 2: https://apsara2-searxng.onrender.com
# SearXNG 3: https://apsara3-searxng.onrender.com
